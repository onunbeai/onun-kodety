{
  "version": 2,
  "interactions": [
    {
      "id": "commerce-hero-load",
      "name": "Entrada do hero",
      "trigger": "load",
      "triggerSelector": "[data-kodety-interaction-id=\"commerce-hero-motion\"]",
      "triggerLabel": "Commerce Hero",
      "triggerTargetMode": "element",
      "actions": [
        {
          "id": "hero-content-enter",
          "name": "Conteúdo do hero",
          "kind": "animate",
          "target": { "selector": "[data-kodety-interaction-id=\"hero-content\"]", "label": "Hero Content", "scope": "document", "mode": "element" },
          "start": 0.08,
          "duration": 0.72,
          "ease": "power2.out",
          "from": { "opacity": 0, "y": 28 },
          "to": { "opacity": 1, "y": 0 },
          "keyframes": [],
          "repeat": 0,
          "repeatDelay": 0,
          "yoyo": false,
          "stagger": 0,
          "staggerFrom": "start",
          "textSplit": "none",
          "className": "",
          "variableName": "--motion-value",
          "variableValue": 1,
          "eventName": "kodefy-action",
          "inputName": "",
          "inputValue": true
        }
      ],
      "enabled": true,
      "repeat": 0,
      "yoyo": false,
      "hoverInAction": "restart",
      "hoverOutAction": "reverse",
      "clickAction": "toggle",
      "mouseMoveAxis": "both",
      "mouseMoveReverse": true,
      "mouseMoveSmoothing": 0.18,
      "scrollStart": "top 80%",
      "scrollEnd": "bottom 20%",
      "scrollScrub": false,
      "scrollSmoothing": 0,
      "scrollToggleActions": "play none none reverse",
      "scrollTriggerSelector": "",
      "scrollTriggerLabel": "Commerce Hero",
      "customEvent": "kodefy-interaction",
      "reducedMotion": "end",
      "enabledBreakpoints": ["desktop", "tablet", "mobile"]
    },
    {
      "id": "featured-products-scroll",
      "name": "Produtos em destaque",
      "trigger": "scroll",
      "triggerSelector": "[data-kodety-interaction-id=\"featured-products-motion\"]",
      "triggerLabel": "Featured Products",
      "triggerTargetMode": "element",
      "actions": [
        {
          "id": "featured-products-enter",
          "name": "Cards de produtos",
          "kind": "animate",
          "target": { "selector": ".kodefy-product-card", "label": "Product Cards", "scope": "descendants", "mode": "class" },
          "start": 0,
          "duration": 0.6,
          "ease": "power2.out",
          "from": { "opacity": 0, "y": 24 },
          "to": { "opacity": 1, "y": 0 },
          "keyframes": [],
          "repeat": 0,
          "repeatDelay": 0,
          "yoyo": false,
          "stagger": 0.08,
          "staggerFrom": "start",
          "textSplit": "none",
          "className": "",
          "variableName": "--motion-value",
          "variableValue": 1,
          "eventName": "kodefy-action",
          "inputName": "",
          "inputValue": true
        }
      ],
      "enabled": true,
      "repeat": 0,
      "yoyo": false,
      "hoverInAction": "restart",
      "hoverOutAction": "reverse",
      "clickAction": "toggle",
      "mouseMoveAxis": "both",
      "mouseMoveReverse": true,
      "mouseMoveSmoothing": 0.18,
      "scrollStart": "top 82%",
      "scrollEnd": "bottom 20%",
      "scrollScrub": false,
      "scrollSmoothing": 0,
      "scrollToggleActions": "play none none reverse",
      "scrollTriggerSelector": "",
      "scrollTriggerLabel": "Featured Products",
      "customEvent": "kodefy-interaction",
      "reducedMotion": "end",
      "enabledBreakpoints": ["desktop", "tablet", "mobile"]
    }
  ]
}
