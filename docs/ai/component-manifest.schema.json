{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://coday.dev/schemas/component-manifest-1.0.0.json",
  "title":"Coday Component Manifest",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","id","name","displayName","version","exportName","controls","defaultProps","sizing","dependencies","capabilities"],
  "properties":{
    "schemaVersion":{"const":"1.0.0"},
    "id":{"type":"string","pattern":"^[A-Za-z0-9][A-Za-z0-9._-]+$"},
    "name":{"type":"string","minLength":1},
    "displayName":{"type":"string","minLength":1},
    "description":{"type":"string"},
    "version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "exportName":{"type":"string","minLength":1},
    "controls":{"type":"object","additionalProperties":{"$ref":"control-definition.schema.json"}},
    "defaultProps":{"type":"object"},
    "sizing":{"$ref":"#/$defs/sizing"},
    "events":{"type":"object","additionalProperties":{"$ref":"#/$defs/event"}},
    "dependencies":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
    "capabilities":{"type":"array","uniqueItems":true,"items":{"enum":["assets","cms","events","slots","responsive","animation"]}}
  },
  "$defs":{
    "sizing":{"type":"object","additionalProperties":false,"required":["width","height"],"properties":{"width":{"enum":["fixed","fill","hug","intrinsic"]},"height":{"enum":["fixed","fill","hug","intrinsic"]},"defaultWidth":{"type":"number","exclusiveMinimum":0},"defaultHeight":{"type":"number","exclusiveMinimum":0},"minWidth":{"type":"number","minimum":0},"minHeight":{"type":"number","minimum":0},"aspectRatio":{"type":"number","exclusiveMinimum":0}}},
    "event":{"type":"object","additionalProperties":false,"required":["title"],"properties":{"title":{"type":"string"},"description":{"type":"string"},"payload":{"type":"object","additionalProperties":{"enum":["string","number","boolean","object","array"]}}}}
  }
}
